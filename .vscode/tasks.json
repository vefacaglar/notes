{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}/apps/windows"
  },
  "tasks": [
    {
      "label": "Windows: Build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "src/Notes/Notes.csproj", "-p:Platform=x64", "-nologo", "-v", "q", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "Windows: Test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "tests/NotesCore.Tests", "-nologo", "/property:GenerateFullPaths=true"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "Windows: Build and Test",
      "dependsOrder": "sequence",
      "dependsOn": ["Windows: Build", "Windows: Test"],
      "problemMatcher": []
    },
    {
      "label": "Windows: Run (temp notes)",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "src/Notes/Notes.csproj", "-p:Platform=x64", "--", "--root", "${env:TEMP}\\NotesTemp"],
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "Windows: Run (real notes)",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "src/Notes/Notes.csproj", "-p:Platform=x64"],
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "Windows: Clean",
      "type": "process",
      "command": "dotnet",
      "args": ["clean", "Notes.slnx", "-p:Platform=x64", "-nologo", "-v", "q"],
      "problemMatcher": []
    },
    {
      "label": "macOS: Build",
      "type": "shell",
      "command": "swift build",
      "options": { "cwd": "${workspaceFolder}/apps/macos" },
      "problemMatcher": "$swiftc",
      "group": "build",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "macOS: Test",
      "type": "shell",
      "command": "swift test",
      "options": { "cwd": "${workspaceFolder}/apps/macos" },
      "problemMatcher": "$swiftc",
      "group": "test",
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "macOS: Build and Test",
      "dependsOrder": "sequence",
      "dependsOn": ["macOS: Build", "macOS: Test"],
      "problemMatcher": []
    },
    {
      "label": "macOS: Run (temp notes)",
      "type": "shell",
      "command": "mkdir -p \"$TMPDIR/NotesTemp\" \"$TMPDIR/NotesTempSupport\" && swift run Notes -notesFolder \"$TMPDIR/NotesTemp\" -supportFolder \"$TMPDIR/NotesTempSupport\"",
      "options": { "cwd": "${workspaceFolder}/apps/macos" },
      "problemMatcher": "$swiftc",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "macOS: Run (real notes)",
      "type": "shell",
      "command": "./scripts/bundle.sh && open build/Notes.app",
      "options": { "cwd": "${workspaceFolder}/apps/macos" },
      "problemMatcher": "$swiftc",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "macOS: Bundle",
      "type": "shell",
      "command": "./scripts/bundle.sh",
      "options": { "cwd": "${workspaceFolder}/apps/macos" },
      "problemMatcher": "$swiftc",
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "macOS: Clean",
      "type": "shell",
      "command": "swift package clean && rm -rf build",
      "options": { "cwd": "${workspaceFolder}/apps/macos" },
      "problemMatcher": []
    },
    {
      "label": "macOS: Build for debugging",
      "type": "shell",
      "command": "mkdir -p \"$TMPDIR/NotesTemp\" \"$TMPDIR/NotesTempSupport\" && swift build",
      "options": { "cwd": "${workspaceFolder}/apps/macos" },
      "problemMatcher": "$swiftc",
      "presentation": { "reveal": "silent", "clear": true }
    }
  ]
}
