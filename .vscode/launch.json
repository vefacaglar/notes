{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Windows: Debug (temp notes)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Windows: Build",
      "program": "${workspaceFolder}/apps/windows/src/Notes/bin/x64/Debug/net10.0-windows10.0.19041.0/Notes.exe",
      "args": [
        "--root",
        "${env:TEMP}\\NotesTemp"
      ],
      "cwd": "${workspaceFolder}/apps/windows/src/Notes",
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "Windows: Debug (real notes)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Windows: Build",
      "program": "${workspaceFolder}/apps/windows/src/Notes/bin/x64/Debug/net10.0-windows10.0.19041.0/Notes.exe",
      "cwd": "${workspaceFolder}/apps/windows/src/Notes",
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "Windows: Attach to running app",
      "type": "coreclr",
      "request": "attach",
      "processName": "Notes.exe"
    },
    {
      "name": "macOS: Debug (temp notes)",
      "type": "swift",
      "request": "launch",
      "preLaunchTask": "macOS: Build for debugging",
      "program": "${workspaceFolder}/apps/macos/.build/debug/Notes",
      "args": [
        "-notesFolder",
        "${env:TMPDIR}/NotesTemp",
        "-supportFolder",
        "${env:TMPDIR}/NotesTempSupport"
      ],
      "cwd": "${workspaceFolder}/apps/macos"
    },
    {
      "name": "macOS: Debug (temp notes, Turkish)",
      "type": "swift",
      "request": "launch",
      "preLaunchTask": "macOS: Build for debugging",
      "program": "${workspaceFolder}/apps/macos/.build/debug/Notes",
      "args": [
        "-notesFolder",
        "${env:TMPDIR}/NotesTemp",
        "-supportFolder",
        "${env:TMPDIR}/NotesTempSupport",
        "-lang",
        "tr"
      ],
      "cwd": "${workspaceFolder}/apps/macos"
    },
    {
      "name": "macOS: Attach to running app",
      "type": "swift",
      "request": "attach",
      "program": "${workspaceFolder}/apps/macos/.build/debug/Notes"
    },
    {
      "type": "swift",
      "request": "launch",
      "args": [],
      "cwd": "${workspaceFolder:notes}/apps/macos",
      "name": "Debug Notes (apps/macos)",
      "target": "Notes",
      "configuration": "debug",
      "preLaunchTask": "swift: Build Debug Notes (apps/macos)"
    },
    {
      "type": "swift",
      "request": "launch",
      "args": [],
      "cwd": "${workspaceFolder:notes}/apps/macos",
      "name": "Release Notes (apps/macos)",
      "target": "Notes",
      "configuration": "release",
      "preLaunchTask": "swift: Build Release Notes (apps/macos)"
    }
  ]
}
