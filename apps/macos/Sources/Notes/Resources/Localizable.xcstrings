        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taslaklar klasörü başka bir Notes işleminin elinde; bu penceredeki taslaklar o kapanana kadar ayrı bir klasörde tutulur."
          }
        }
