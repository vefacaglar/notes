    "Another Notes process is using the drafts folder. New tabs are kept in a separate folder and move there once it quits.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another Notes process is using the drafts folder. New tabs are kept in a separate folder and move there once it quits."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taslaklar klasörünü başka bir Notes işlemi kullanıyor. Yeni sekmeler ayrı bir klasörde tutulur ve o kapanınca oraya taşınır."
          }
        }
      }
    },
    "Another Notes process owns the drafts folder, so the drafts in this window are kept in a separate folder until it quits.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another Notes process owns the drafts folder, so the drafts in this window are kept in a separate folder until it quits."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taslaklar klasörü başka bir Notes işleminin elinde; bu penceredeki taslaklar o kapanana kadar ayrı bir klasörde tutulur."
          }
        }
      }
